/* styles/states.wxss */

/* ===== 空态（.empty-view）与错误态（.error-view）：全站统一 =====
   约定：
   1. 状态块一律「纯文字 + 可选按钮」，不使用配图或 emoji。
   2. 列表内容区内的状态用基础类；独占整页/整块区域时加 --page 修饰符做垂直居中。
   3. 层级：错误态文案用 --color-text-secondary（需被看见），空态文案用 --color-text-muted（语气轻）。
   4. 按钮几何统一为 64rpx 胶囊：错误态为描边次要按钮，空态为主色实心按钮。
   类名 .empty-view / .error-view 与旧副本类名（.empty-state / .empty-text /
   .error-container 等）不冲突：后者已在用户端与 admin 端全部迁走并删除。 */

.empty-view,
.error-view {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx var(--space-md);
  text-align: center;
}

/* 整页/整块区域的状态：垂直居中（flex:1 用于撑满 flex 父容器，非 flex 父级下自动忽略） */
.empty-view--page,
.error-view--page {
  flex: 1;
  min-height: 60vh;
  padding: var(--space-xl) var(--space-md);
}

.empty-view__text {
  font-size: var(--font-size-body);
  color: var(--color-text-muted);
  line-height: 1.6;
}

.error-view__text {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  line-height: 1.6;
}

/* 空态可选的第二行补充说明 */
.empty-view__subtext {
  margin-top: var(--space-sm);
  font-size: var(--font-size-caption);
  color: var(--color-text-muted);
}

.empty-view__btn,
.error-view__btn {
  margin-top: var(--space-md);
  min-width: 200rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 var(--space-lg);
  font-size: var(--font-size-body-sm);
  border-radius: 32rpx;
}

.empty-view__btn {
  color: var(--color-text-inverse);
  background-color: var(--color-primary);
  border: none;
}

.error-view__btn {
  color: var(--color-primary);
  background-color: var(--color-bg-elevated);
  border: 1rpx solid var(--color-primary);
}

.empty-view__btn::after,
.error-view__btn::after {
  border: none;
}