/* pages/after-sales/detail/index.wxss */
.page-root {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 44px;
  background-color: #fff;
  padding: 0 16rpx;
  border-bottom: 1rpx solid #e5e5e5;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.header-left {
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.back-icon {
  width: 24rpx;
  height: 24rpx;
}

.header-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.header-right {
  width: 44px;
}

.content {
  padding: 20rpx 20rpx 120rpx;
}

.status-section {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 32rpx 20rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.status-section__status {
  font-size: 32rpx;
  font-weight: 500;
  padding: 8rpx 32rpx;
  border-radius: 24rpx;
}

.status-section__status--pending {
  color: #faad14;
  background-color: #fff7e6;
}

.status-section__status--approved {
  color: #52c41a;
  background-color: #f6ffed;
}

.status-section__status--rejected {
  color: #ff4d4f;
  background-color: #fff2f0;
}

.status-section__status--completed {
  color: #1890ff;
  background-color: #e6f7ff;
}

.status-section__status--cancelled {
  color: #999;
  background-color: #f5f5f5;
}

.status-section__desc {
  font-size: 24rpx;
  color: #666;
  text-align: center;
}

.status-section__countdown {
  font-size: 24rpx;
  color: #faad14;
  font-weight: 400;
}

.section {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.section__title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section__content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.info-item__label {
  width: 120rpx;
  font-size: 24rpx;
  color: #666;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.info-item__value {
  flex: 1;
  font-size: 24rpx;
  color: #333;
  line-height: 1.4;
}

.info-item__value--price {
  font-weight: 500;
  color: #ff4d4f;
}

.info-item__value--multiline {
  white-space: pre-wrap;
  word-break: break-all;
}

.proof-media {
  margin-bottom: 16rpx;
}

.proof-media__label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
}

.media-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.media-grid__item {
  width: 140rpx;
  height: 140rpx;
  border-radius: 8rpx;
  overflow: hidden;
  position: relative;
  background: #f5f5f5;
}

.media-grid__item--video {
  background: #000;
}

.media-grid__video-cover {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.media-grid__item-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.media-grid__item-thumb {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.media-grid__item-default-thumb {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #333;
}

.media-grid__item-default-icon {
  font-size: 48rpx;
}

.media-grid__item-play {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 60rpx;
  height: 60rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.media-grid__item-play-icon {
  color: #fff;
  font-size: 24rpx;
  margin-left: 4rpx;
}

.description-item {
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.description-item__label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
  display: block;
}

.description-item__content {
  font-size: 24rpx;
  color: #333;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

.case-item {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.case-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.case-item__image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}

.case-item__content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.case-item__name {
  font-size: 26rpx;
  color: #222;
  line-height: 1.4;
}

.case-item__meta,
.case-item__qty,
.case-item__status {
  font-size: 22rpx;
  color: #777;
}

.case-item__ship {
  font-size: 22rpx;
  color: #666;
}

.case-item__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.case-item__tag {
  font-size: 22rpx;
  color: #0958d9;
  background: #e6f4ff;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
}

.case-item__amount {
  font-size: 26rpx;
  color: #cf1322;
  font-weight: 600;
}

.case-item__unit-price {
  font-size: 24rpx;
  color: #666;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 20rpx;
  border-top: 1rpx solid #e5e5e5;
  display: flex;
  gap: 12rpx;
}

.footer__btn {
  flex: 1;
  height: 80rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 80rpx;
}

.footer__btn--primary {
  background-color: #1890ff;
  color: #fff;
}

.footer__btn--cancel {
  background-color: #fff;
  color: #666;
  border: 1rpx solid #e5e5e5;
}

.footer__btn::after {
  border: none;
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal__mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.modal__content {
  position: relative;
  width: 100%;
  background-color: #fff;
  border-radius: 20rpx 20rpx 0 0;
  max-height: 70vh;
  overflow: hidden;
}

.modal__content--large {
  max-height: 80vh;
}

.modal__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal__title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.modal__close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #999;
}

.modal__body {
  padding: 16rpx 0;
  max-height: calc(70vh - 100rpx);
  overflow-y: auto;
}

.modal__content--large .modal__body {
  max-height: calc(80vh - 100rpx);
}

.modal__footer {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.modal__btn {
  flex: 1;
  height: 88rpx;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 88rpx;
}

.modal__btn--cancel {
  background-color: #fff;
  color: #666;
  border-right: 1rpx solid #f0f0f0;
}

.modal__btn--confirm {
  background-color: #1890ff;
  color: #fff;
}

.modal__btn::after {
  border: none;
}

.modal__item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.modal__item:last-child {
  border-bottom: none;
}

.modal__item-name {
  font-size: 28rpx;
  color: #333;
}

.modal__item-check {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #d9d9d9;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: transparent;
}

.form-item {
  padding: 20rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-item__label {
  font-size: 28rpx;
  color: #333;
}

.form-item__input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  text-align: right;
}

.form-item__value {
  flex: 1;
  font-size: 28rpx;
  color: #666;
  text-align: right;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.form-item__value--selected {
  color: #333;
}

.form-item__arrow {
  font-size: 32rpx;
  color: #ccc;
  margin-left: 8rpx;
}

.modal__tips {
  font-size: 24rpx;
  color: #999;
  padding: 0 32rpx 16rpx;
}

.common-companies {
  padding: 0 32rpx;
}

.common-companies__title {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
  display: block;
}

.common-companies__list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.common-companies__item {
  padding: 12rpx 24rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.logistics-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.logistics-modal__mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.logistics-modal__content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  width: 100%;
  height: 75vh;
  background-color: #fff;
  border-radius: 32rpx 32rpx 0 0;
  overflow: hidden;
  animation: slideUp 0.3s ease-out;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.logistics-modal__header {
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  text-align: center;
}

.logistics-modal__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.logistics-modal__info {
  padding: 24rpx;
  background-color: #fafafa;
}

.logistics-modal__info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.logistics-modal__info-label {
  font-size: 26rpx;
  color: #999;
}

.logistics-modal__info-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.logistics-modal__track {
  padding: 24rpx;
  flex: 1;
  overflow-y: auto;
}

.logistics-modal__track-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.logistics-modal__track-list {
  padding-left: 20rpx;
}

.logistics-modal__track-item {
  display: flex;
  padding: 16rpx 0;
  position: relative;
}

.logistics-modal__track-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #d9d9d9;
  margin-right: 20rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.logistics-modal__track-line {
  position: absolute;
  left: 7rpx;
  top: 36rpx;
  bottom: 0;
  width: 2rpx;
  background-color: #d9d9d9;
}

.logistics-modal__track-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.logistics-modal__track-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
}

.logistics-modal__track-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.logistics-modal__map-section {
  margin-bottom: 24rpx;
}

.logistics-modal__map-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
  border-left: 4rpx solid #1890ff;
}

.logistics-modal__map-container {
  width: 100%;
  height: 400rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.logistics-modal__map {
  width: 100%;
  height: 100%;
}

.logistics-modal__map-buttons {
  display: flex;
  justify-content: flex-end;
}

.logistics-modal__map-btn {
  margin: 0 8rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
  background-color: #f5f5f5;
  color: #666;
}

.logistics-modal__map-btn::after {
  border: none;
}

/* 操作记录 */
.operation-logs {
  padding-left: 20rpx;
}

.operation-log-item {
  display: flex;
  position: relative;
  padding-bottom: 32rpx;
}

.operation-log-item:last-child {
  padding-bottom: 0;
}

.operation-log-item:last-child .operation-log-item__line {
  display: none;
}

.operation-log-item__line {
  position: absolute;
  left: 7rpx;
  top: 24rpx;
  bottom: 0;
  width: 2rpx;
  background-color: #e8e8e8;
}

.operation-log-item__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #1890ff;
  margin-top: 8rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  z-index: 1;
}

.operation-log-item__content {
  flex: 1;
}

.operation-log-item__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.operation-log-item__action {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.operation-log-item__operator {
  font-size: 24rpx;
  color: #999;
}

.operation-log-item__note {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
  line-height: 1.5;
}

.operation-log-item__time {
  font-size: 24rpx;
  color: #999;
}
