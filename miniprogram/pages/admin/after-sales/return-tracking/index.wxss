.return-tracking {
  width: 100%;
  min-height: 100vh;
  background-color: var(--color-bg);
}

.return-tracking__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 0;
  background-color: transparent;
  border-bottom: none;
  padding: 0;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.return-tracking__header-left {
  width: 60px;
}

.return-tracking__header-title {
  font-size: 16px;
  font-weight: bold;
  color: #333;
}

.return-tracking__header-right {
  width: 60px;
}

.return-tracking__content {
  margin-top: 0;
  padding: 16px;
}

.return-tracking__order-info {
  display: flex;
  align-items: center;
  margin-bottom: 12px;
  padding: 12px;
  background-color: var(--color-bg-elevated);
  border-radius: 8px;
}

.return-tracking__order-label {
  font-size: 14px;
  color: var(--color-text-secondary);
  margin-right: 8px;
  min-width: 80px;
}

.return-tracking__order-value {
  font-size: 14px;
  color: #333;
  flex: 1;
}

.return-tracking__logistics-section {
  margin-top: 16px;
  padding: 16px;
  background-color: var(--color-bg-elevated);
  border-radius: 8px;
}

.return-tracking__section-title {
  font-size: 16px;
  font-weight: bold;
  color: #333;
  margin-bottom: 16px;
}

.return-tracking__form-item {
  display: flex;
  align-items: center;
  margin-bottom: 16px;
}

.return-tracking__form-label {
  font-size: 14px;
  color: var(--color-text-secondary);
  margin-right: 12px;
  min-width: 80px;
}

.return-tracking__form-select {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 12px;
  border: 1px solid #e5e5e5;
  border-radius: 4px;
  background-color: #f9f9f9;
}

.return-tracking__form-select-value {
  font-size: 14px;
  color: #333;
}

.return-tracking__form-select-arrow {
  font-size: 12px;
  color: var(--color-text-muted);
}

.return-tracking__form-input {
  flex: 1;
  padding: 8px 12px;
  border: 1px solid #e5e5e5;
  border-radius: 4px;
  font-size: 14px;
  color: #333;
  background-color: #f9f9f9;
}

.return-tracking__submit-btn {
  margin-top: 32px;
  width: 100%;
  height: 44px;
  background-color: var(--color-success);
  color: var(--color-text-inverse);
  font-size: 16px;
  border-radius: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.return-tracking__submit-btn:disabled {
  background-color: #ccc;
}

/* 快递公司选择器（外壳由 modal-shell 提供） */
.return-tracking__picker-header {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 44px;
  padding: 0 16px;
  border-bottom: 1px solid #e5e5e5;
}

.return-tracking__picker-cancel {
  font-size: 14px;
  color: var(--color-text-muted);
}

.return-tracking__picker-title {
  font-size: 16px;
  color: #333;
  font-weight: bold;
}

.return-tracking__picker-confirm {
  font-size: 14px;
  color: var(--color-success);
  font-weight: bold;
}

.return-tracking__picker-view {
  background-color: var(--color-bg);
}

.return-tracking__picker-view view {
  font-size: 16px;
  color: #333;
}
