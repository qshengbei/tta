/* pages/admin/after-sales/detail/index.wxss */
.page-root {
  min-height: 100vh;
  background-color: var(--color-bg);
}

.content {
  padding: 20rpx 20rpx 120rpx;
}

.status-section {
  background-color: var(--color-bg-elevated);
  border-radius: 12rpx;
  padding: 32rpx 20rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.status-section__status {
  font-size: 32rpx;
  font-weight: 500;
  padding: 8rpx 32rpx;
  border-radius: 24rpx;
}

.status-section__status--pending {
  color: var(--color-warning);
  background-color: #fff7e6;
}

.status-section__status--approved {
  color: var(--color-success);
  background-color: #f6ffed;
}

.status-section__status--rejected {
  color: var(--color-danger);
  background-color: #fff2f0;
}

.status-section__status--completed {
  color: var(--color-primary);
  background-color: #e6f7ff;
}

.status-section__status--cancelled {
  color: var(--color-text-muted);
  background-color: var(--color-bg);
}

.status-section__desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  text-align: center;
}

.status-section__countdown {
  font-size: 24rpx;
  color: var(--color-warning);
  font-weight: 400;
}

.section {
  background-color: var(--color-bg-elevated);
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.section__title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section__content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.info-item__label {
  width: 120rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  flex-shrink: 0;
  margin-top: 4rpx;
}

.info-item__value {
  flex: 1;
  font-size: 24rpx;
  color: #333;
  line-height: 1.4;
}

.info-item__value--price {
  font-weight: 500;
  color: var(--color-danger);
}

.info-item__value--multiline {
  white-space: pre-wrap;
  word-break: break-all;
}

.proof-media {
  margin-bottom: 16rpx;
}

.proof-media__label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
  display: block;
}

.media-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.media-grid__item {
  width: 140rpx;
  height: 140rpx;
  border-radius: 8rpx;
  overflow: hidden;
  position: relative;
  background: var(--color-bg);
}

.media-grid__item--video {
  background: var(--color-bg-inverse);
}

.media-grid__video-cover {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.media-grid__item-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.media-grid__item-thumb {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.media-grid__item-default-thumb {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #333;
}

.media-grid__item-default-icon {
  font-size: 48rpx;
}

.media-grid__item-play {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 60rpx;
  height: 60rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.media-grid__item-play-icon {
  color: var(--color-text-inverse);
  font-size: 24rpx;
  margin-left: 4rpx;
}

.description-item {
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.description-item__label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
  display: block;
}

.description-item__content {
  font-size: 24rpx;
  color: #333;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

.case-item {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  align-items: center;
}

.case-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.case-item__image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: var(--color-bg);
  flex-shrink: 0;
}

.case-item__content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.case-item__name {
  font-size: 26rpx;
  color: #222;
  line-height: 1.4;
}

.case-item__meta,
.case-item__qty,
.case-item__status {
  font-size: 22rpx;
  color: #777;
}

.case-item__ship {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.case-item__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.case-item__tag {
  font-size: 22rpx;
  color: var(--color-primary);
  background: #e6f4ff;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
}

.case-item__amount {
  font-size: 26rpx;
  color: var(--color-danger);
  font-weight: 600;
}

.case-item__unit-price {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.case-item__confirm-btn {
  flex-shrink: 0;
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  background-color: var(--color-primary);
  color: var(--color-text-inverse);
  border: none;
}

.case-item__confirm-btn::after {
  border: none;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: var(--color-bg-elevated);
  padding: 20rpx;
  border-top: 1rpx solid #e5e5e5;
  display: flex;
  gap: 12rpx;
  z-index: 100;
}

.footer__btn {
  flex: 1;
  height: 80rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 80rpx;
}

.footer__btn--primary {
  background-color: var(--color-primary);
  color: var(--color-text-inverse);
}

.footer__btn--cancel {
  background-color: var(--color-bg-elevated);
  color: var(--color-text-secondary);
  border: 1rpx solid #e5e5e5;
}

.footer__btn--reject {
  background-color: var(--color-bg-elevated);
  color: var(--color-danger);
  border: 1rpx solid var(--color-danger);
}

.footer__btn::after {
  border: none;
}

.footer__btn--secondary {
  background-color: var(--color-bg-elevated);
  color: var(--color-primary);
  border: 1rpx solid var(--color-primary);
}

/* "买家已拒签，同意退款"文案较长：三个按钮并排时占更多宽度并缩小字号 */
.footer__btn--refused {
  flex: 1.7;
  font-size: 24rpx;
  padding: 0 8rpx;
  white-space: nowrap;
}

/* 售后弹窗内容区（外壳由 modal-shell 提供） */
.intercept-modal__body {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 20rpx;
}

.intercept-modal__desc {
  font-size: 24rpx;
  color: var(--color-text-muted);
  text-align: center;
  margin-bottom: 20rpx;
  display: block;
}

.intercept-modal__buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.intercept-modal-btn {
  flex: 1;
  min-width: calc(50% - 6rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 12rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  border: none;
}

.intercept-modal-btn::after {
  border: none;
}

.intercept-modal-btn--success {
  background: linear-gradient(135deg, var(--color-success) 0%, var(--color-success-dark) 100%);
  color: var(--color-text-inverse);
}

.intercept-modal-btn--warning {
  background: linear-gradient(135deg, var(--color-warning) 0%, var(--color-warning-dark) 100%);
  color: var(--color-text-inverse);
}

.intercept-modal-btn--danger {
  background: linear-gradient(135deg, var(--color-danger) 0%, var(--color-danger-dark) 100%);
  color: var(--color-text-inverse);
}

.intercept-modal-btn__icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.intercept-modal-btn__text {
  font-weight: 500;
  font-size: 26rpx;
}

.intercept-modal-btn__desc {
  font-size: 22rpx;
  opacity: 0.9;
  margin-top: 4rpx;
}

/* 物流信息弹窗样式已抽为 components/logistics-modal 组件 */

/* 验货不通过弹窗 */
.inspect-fail__body {
  padding-bottom: 40rpx;
}

.inspect-fail__input-section {
  margin-top: 32rpx;
}

.inspect-fail__textarea {
  width: 100%;
  height: 200rpx;
  padding: 24rpx;
  background-color: #f9f9f9;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

/* 寄回运费补偿调整弹窗 */
.compensation-modal__field {
  margin-top: 24rpx;
}

.compensation-modal__field-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #333;
}

.compensation-modal__input-wrap {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background-color: #f9f9f9;
  border-radius: 16rpx;
}

.compensation-modal__symbol {
  margin-right: 8rpx;
  font-size: 32rpx;
  color: #333;
}

.compensation-modal__input {
  flex: 1;
  font-size: 32rpx;
  color: #333;
}

.compensation-modal__textarea {
  width: 100%;
  height: 160rpx;
  padding: 24rpx;
  background-color: #f9f9f9;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.compensation-modal__buttons {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}

.compensation-modal-btn {
  flex: 1;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: none;
}

.compensation-modal-btn::after {
  border: none;
}

.compensation-modal-btn--default {
  background-color: var(--color-bg);
  color: var(--color-text-secondary);
}

.compensation-modal-btn--primary {
  background: linear-gradient(135deg, var(--color-warning) 0%, var(--color-warning-dark) 100%);
  color: var(--color-text-inverse);
}

.inspect-fail__upload-section {
  margin-top: 32rpx;
}

.inspect-fail__upload-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 16rpx;
}

.inspect-fail__upload-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.inspect-fail__upload-item {
  width: 160rpx;
  height: 160rpx;
  position: relative;
  border-radius: 12rpx;
  overflow: hidden;
}

.inspect-fail__upload-image {
  width: 100%;
  height: 100%;
}

.inspect-fail__upload-video {
  background-color: var(--color-bg-inverse);
}

.inspect-fail__video-cover {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.inspect-fail__upload-video-item {
  width: 100%;
  height: 100%;
  display: block;
}

.inspect-fail__play-btn {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.inspect-fail__play-icon {
  color: var(--color-text-inverse);
  font-size: 32rpx;
  margin-left: 6rpx;
}

.inspect-fail__upload-add {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--color-bg);
  border: 2rpx dashed #d9d9d9;
}

.inspect-fail__upload-add-icon {
  font-size: 48rpx;
  color: var(--color-text-muted);
}

.inspect-fail__upload-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0, 0, 0, 0.6);
  color: var(--color-text-inverse);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.inspect-fail__submit-btn {
  margin-top: 40rpx;
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, var(--color-danger) 0%, var(--color-danger-dark) 100%);
  color: var(--color-text-inverse);
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 44rpx;
  border: none;
}

.inspect-fail__submit-btn::after {
  border: none;
}

.operation-logs {
  padding-left: 20rpx;
}

.operation-log-item {
  display: flex;
  position: relative;
  padding-bottom: 32rpx;
}

.operation-log-item:last-child {
  padding-bottom: 0;
}

.operation-log-item:last-child .operation-log-item__line {
  display: none;
}

.operation-log-item__line {
  position: absolute;
  left: 7rpx;
  top: 24rpx;
  bottom: 0;
  width: 2rpx;
  background-color: #e8e8e8;
}

.operation-log-item__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: var(--color-primary);
  margin-top: 8rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  z-index: 1;
}

.operation-log-item__content {
  flex: 1;
}

.operation-log-item__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.operation-log-item__action {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.operation-log-item__operator {
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.operation-log-item__note {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
  line-height: 1.5;
}

.operation-log-item__time {
  font-size: 24rpx;
  color: var(--color-text-muted);
}
