<!--pages/admin/after-sales/detail/index.wxml-->
<view class="page-root">
  
  <view class="content">
    <!-- 售后状态 -->
    <view class="status-section">
      <view class="status-section__status {{afterSales.statusClass}}">
        {{afterSales.statusText}}
        <text wx:if="{{autoProcessCountdown && (afterSales.status === 'submitted' || afterSales.status === 'pending') && !afterSales.autoProcessed}}" class="status-section__countdown">（{{autoProcessCountdown}}）</text>
      </view>
      <view class="status-section__desc">{{afterSales.statusDesc}}</view>
    </view>
    
    <!-- 订单信息 -->
    <view class="section">
      <view class="section__title">订单信息</view>
      <view class="section__content">
        <view class="info-item">
          <text class="info-item__label">订单号：</text>
          <text class="info-item__value">{{afterSales.orderNo || afterSales.orderId}}</text>
        </view>
        <view class="info-item">
          <text class="info-item__label">申请时间：</text>
          <text class="info-item__value">{{afterSales.createdAtText}}</text>
        </view>
        <view class="info-item">
          <text class="info-item__label">更新时间：</text>
          <text class="info-item__value">{{afterSales.updatedAtText}}</text>
        </view>
      </view>
    </view>
    
    <!-- 售后信息 -->
    <view class="section">
      <view class="section__title">售后信息</view>
      <view class="section__content">
        <view class="info-item">
          <text class="info-item__label">售后类型：</text>
          <text class="info-item__value">{{afterSales.typeText}}</text>
        </view>
        <view wx:if="{{afterSales.goodsStatus}}" class="info-item">
          <text class="info-item__label">货物状态：</text>
          <text class="info-item__value">{{afterSales.goodsStatus === 'received' ? '已收到货' : '未收到货'}}</text>
        </view>
        <view class="info-item">
          <text class="info-item__label">商品金额：</text>
          <text class="info-item__value">¥{{afterSales.totalItemAmount}}</text>
        </view>
        <view class="info-item">
          <text class="info-item__label">退款金额：</text>
          <text class="info-item__value info-item__value--price">¥{{afterSales.refundAmount}}</text>
        </view>
        <view class="info-item">
          <text class="info-item__label">申请件数：</text>
          <text class="info-item__value">{{afterSales.totalApplyQty}} 件 / {{afterSales.itemCount}} 个商品项</text>
        </view>
        <view class="info-item">
          <text class="info-item__label">售后原因：</text>
          <text class="info-item__value info-item__value--multiline">{{afterSales.reason}}</text>
        </view>
        <view wx:if="{{afterSales.shippingResponsibilityText}}" class="info-item">
          <text class="info-item__label">运费归属：</text>
          <text class="info-item__value">{{afterSales.shippingResponsibilityText}}</text>
        </view>
      </view>
    </view>

    <view class="section" wx:if="{{afterSalesItems.length > 0}}">
      <view class="section__title">售后商品</view>
      <view class="section__content">
        <view class="case-item" wx:for="{{afterSalesItems}}" wx:key="_id">
          <image wx:if="{{item.image}}" src="{{item.image}}" class="case-item__image"></image>
          <view class="case-item__content">
            <text class="case-item__name">{{item.name}}</text>
            <text class="case-item__meta">{{item.skuName}}</text>
            <view class="case-item__row">
              <text class="case-item__tag">{{item.typeText}}</text>
              <text class="case-item__qty">x{{item.applyQty}}</text>
            </view>
            <view class="case-item__row">
              <text class="case-item__unit-price">¥{{item.unitPrice}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    
    <!-- 描述与凭证 -->
    <view class="section" wx:if="{{afterSales.description || (afterSales.proofImages && afterSales.proofImages.length > 0) || (afterSales.proofVideos && afterSales.proofVideos.length > 0)}}">
      <view class="section__title">描述与凭证</view>
      <view class="section__content">
        <!-- 图片/视频凭证（合并显示，按上传顺序） -->
        <view wx:if="{{(afterSales.proofImages && afterSales.proofImages.length > 0) || (afterSales.proofVideos && afterSales.proofVideos.length > 0)}}" class="proof-media">
          <text class="proof-media__label">图片/视频凭证：</text>
          <view class="media-grid">
            <block wx:for="{{combinedMediaList}}" wx:key="index">
              <!-- 图片 -->
              <view wx:if="{{item.type === 'image'}}" class="media-grid__item media-grid__item--image">
                <image src="{{item.path}}" class="media-grid__item-image" bindtap="previewImageFromCombined" data-index="{{index}}"></image>
              </view>
              <!-- 视频 -->
              <view wx:else class="media-grid__item media-grid__item--video">
                <image wx:if="{{item.thumb}}" src="{{item.thumb}}" class="media-grid__item-thumb"></image>
                <view wx:else class="media-grid__item-default-thumb">
                  <text class="media-grid__item-default-icon">🎬</text>
                </view>
                <view class="media-grid__item-play" bindtap="playVideoFromCombined" data-index="{{index}}">
                  <text class="media-grid__item-play-icon">▶</text>
                </view>
              </view>
            </block>
          </view>
        </view>
        <!-- 详细说明 -->
        <view wx:if="{{afterSales.description}}" class="description-item">
          <text class="description-item__label">详细说明：</text>
          <text class="description-item__content">{{afterSales.description}}</text>
        </view>
      </view>
    </view>
    
    <!-- 联系信息 -->
    <view class="section">
      <view class="section__title">联系信息</view>
      <view class="section__content">
        <view class="info-item">
          <text class="info-item__label">联系人：</text>
          <text class="info-item__value">{{afterSales.contactName}}</text>
        </view>
        <view class="info-item">
          <text class="info-item__label">联系电话：</text>
          <text class="info-item__value">{{afterSales.contactPhone}}</text>
        </view>
      </view>
    </view>
    
    <!-- 处理信息 -->
    <view class="section" wx:if="{{afterSales.processInfo}}">
      <view class="section__title">处理信息</view>
      <view class="section__content">
        <view class="info-item">
          <text class="info-item__label">处理意见：</text>
          <text class="info-item__value info-item__value--multiline">{{afterSales.processInfo.opinion}}</text>
        </view>
        <view class="info-item" wx:if="{{afterSales.processInfo.processTimeText}}">
          <text class="info-item__label">处理时间：</text>
          <text class="info-item__value">{{afterSales.processInfo.processTimeText}}</text>
        </view>
      </view>
    </view>

    <!-- 验货凭证（验货不通过时显示） -->
    <view class="section" wx:if="{{afterSales.inspectEvidence && (afterSales.inspectEvidence.images.length > 0 || afterSales.inspectEvidence.videos.length > 0)}}">
      <view class="section__title">验货凭证</view>
      <view class="section__content">
        <view wx:if="{{afterSales.inspectEvidence.images.length > 0}}" class="proof-media">
          <text class="proof-media__label">图片凭证：</text>
          <view class="media-grid">
            <block wx:for="{{afterSales.inspectEvidence.images}}" wx:key="index">
              <view class="media-grid__item media-grid__item--image">
                <image src="{{item}}" class="media-grid__item-image" bindtap="previewInspectEvidenceImage" data-index="{{index}}"></image>
              </view>
            </block>
          </view>
        </view>
        <view wx:if="{{afterSales.inspectEvidence.videos.length > 0}}" class="proof-media">
          <text class="proof-media__label">视频凭证：</text>
          <view class="media-grid">
            <view class="media-grid__item media-grid__item--video">
              <view class="media-grid__video-cover" bindtap="previewInspectEvidenceVideo">
                <image wx:if="{{afterSales.inspectEvidence.videoThumbs[0]}}" src="{{afterSales.inspectEvidence.videoThumbs[0]}}" class="media-grid__item-image" mode="aspectFill"></image>
                <video wx:else src="{{afterSales.inspectEvidence.videos[0]}}" class="media-grid__item-image" object-fit="cover" muted controls="{{false}}" show-center-play-btn="{{false}}" show-play-btn="{{false}}" show-fullscreen-btn="{{false}}"></video>
                <view class="media-grid__item-play">
                  <text class="media-grid__item-play-icon">▶</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
    
    <!-- 退货物流信息 -->
    <view class="section" wx:if="{{afterSales.returnTrackingNumber}}">
      <view class="section__title">退货物流信息</view>
      <view class="section__content">
        <view class="info-item">
          <text class="info-item__label">快递公司：</text>
          <text class="info-item__value">{{afterSales.returnCompanyName || '未知'}}</text>
        </view>
        <view class="info-item">
          <text class="info-item__label">退货单号：</text>
          <text class="info-item__value">{{afterSales.returnTrackingNumber}}</text>
        </view>
      </view>
    </view>

    <!-- 商家寄回物流信息 -->
    <view class="section" wx:if="{{afterSales.sellerReturnLogistics && afterSales.sellerReturnLogistics.trackingNumber}}">
      <view class="section__title">商家寄回物流</view>
      <view class="section__content">
        <view class="info-item">
          <text class="info-item__label">快递公司：</text>
          <text class="info-item__value">{{afterSales.sellerReturnLogistics.companyName}}</text>
        </view>
        <view class="info-item">
          <text class="info-item__label">运单号：</text>
          <text class="info-item__value">{{afterSales.sellerReturnLogistics.trackingNumber}}</text>
        </view>
      </view>
    </view>
    
    <!-- 操作记录 -->
    <view class="section" wx:if="{{operationLogs.length > 0}}">
      <view class="section__title">操作记录</view>
      <view class="section__content">
        <view class="operation-logs">
          <view wx:for="{{operationLogs}}" wx:key="_id" class="operation-log-item">
            <view class="operation-log-item__line"></view>
            <view class="operation-log-item__dot"></view>
            <view class="operation-log-item__content">
              <view class="operation-log-item__header">
                <text class="operation-log-item__action">{{item.actionText}}</text>
                <text class="operation-log-item__operator">{{item.operatorText}}</text>
              </view>
              <view wx:if="{{item.note}}" class="operation-log-item__note">
                <text>{{item.note}}</text>
              </view>
              <text class="operation-log-item__time">{{item.createdAtText}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    
    <!-- 底部按钮（管理员端） -->
    <!-- 待处理/审核中：显示同意/拒绝/开始拦截 -->
    <view class="footer" wx:if="{{afterSales.status === 'submitted' || afterSales.status === 'reviewing' || afterSales.status === 'pending'}}">
      <button class="footer__btn footer__btn--reject" bindtap="handleReject">拒绝</button>
      <button class="footer__btn footer__btn--secondary" bindtap="handleStartIntercepting">开始拦截</button>
      <button wx:if="{{!afterSales.isNotReceivedRefund}}" class="footer__btn footer__btn--primary" bindtap="handleApprove">同意</button>
    </view>
    <!-- 拦截中：显示完成拦截按钮 -->
    <view class="footer" wx:if="{{afterSales.status === 'intercepting'}}">
      <button class="footer__btn footer__btn--primary" bindtap="showInterceptOptions">完成拦截</button>
    </view>
    
    <!-- 待商家收货：只显示查看物流按钮和确认收货按钮 -->
    <view class="footer" wx:if="{{afterSales.status === 'waiting_seller_receive'}}">
      <button class="footer__btn" bindtap="showReturnLogistics">查看退货物流</button>
      <button wx:if="{{afterSalesItems.length > 0}}" class="footer__btn footer__btn--primary" bindtap="handleConfirmReceipt" data-item-id="{{afterSalesItems[0]._id}}">确认收货</button>
    </view>
    
    <!-- 商家验货中：显示验货通过和验货不通过按钮 -->
    <view class="footer" wx:if="{{afterSales.status === 'seller_reviewing'}}">
      <button class="footer__btn footer__btn--danger" bindtap="handleInspectFail">验货不通过</button>
      <button class="footer__btn footer__btn--primary" bindtap="handleInspectPass">验货通过</button>
    </view>

    <!-- 商家寄回中：显示填写寄回单号按钮 -->
    <view class="footer" wx:if="{{afterSales.status === 'seller_returning'}}">
      <button wx:if="{{afterSales.sellerReturnLogistics && afterSales.sellerReturnLogistics.trackingNumber}}" class="footer__btn" bindtap="showSellerReturnLogistics">查看寄回物流</button>
      <button wx:if="{{afterSalesItems.length > 0}}" class="footer__btn footer__btn--primary" bindtap="goToFillReturnTracking" data-item-id="{{afterSalesItems[0]._id}}">填写寄回单号</button>
    </view>

    <!-- 待买家收货：显示查看寄回物流按钮 -->
    <view class="footer" wx:if="{{afterSales.status === 'buyer_receiving'}}">
      <button wx:if="{{afterSales.sellerReturnLogistics && afterSales.sellerReturnLogistics.trackingNumber}}" class="footer__btn footer__btn--primary" bindtap="showSellerReturnLogistics">查看寄回物流</button>
    </view>
  </view>
  
  <!-- 拦截选项弹窗 -->
  <view class="intercept-modal-mask" wx:if="{{showInterceptOptions}}" bindtap="hideInterceptOptions">
    <view class="intercept-modal" catchtap="preventModalClose">
      <view class="intercept-modal__header">
        <text class="intercept-modal__title">物流拦截结果</text>
        <text class="intercept-modal__close" bindtap="hideInterceptOptions">✕</text>
      </view>
      <view class="intercept-modal__body">
        <text class="intercept-modal__desc">请根据拦截结果选择处理方式</text>
        <view class="intercept-modal__buttons">
          <button class="intercept-modal-btn intercept-modal-btn--success" bindtap="handleCompleteIntercepting" data-action="approve" data-reason="拦截物流成功，同意申请">
            <text class="intercept-modal-btn__icon">✓</text>
            <text class="intercept-modal-btn__text">拦截成功</text>
            <text class="intercept-modal-btn__desc">同意申请</text>
          </button>
          <button class="intercept-modal-btn intercept-modal-btn--warning" bindtap="handleCompleteIntercepting" data-action="approve" data-reason="拦截物流失败，同意申请，请在签收后将申请退款的商品寄回">
            <text class="intercept-modal-btn__icon">⚠</text>
            <text class="intercept-modal-btn__text">拦截失败</text>
            <text class="intercept-modal-btn__desc">同意申请（请寄回）</text>
          </button>
          <button class="intercept-modal-btn intercept-modal-btn--danger" bindtap="handleCompleteIntercepting" data-action="reject" data-reason="物流拦截失败，请在快递送达后拒签或退回">
            <text class="intercept-modal-btn__icon">✗</text>
            <text class="intercept-modal-btn__text">拦截失败</text>
            <text class="intercept-modal-btn__desc">拒绝申请（请拒签）</text>
          </button>
          <button class="intercept-modal-btn intercept-modal-btn--danger" bindtap="handleCompleteIntercepting" data-action="reject" data-reason="快递已送达，请拒签或退回">
            <text class="intercept-modal-btn__icon">✗</text>
            <text class="intercept-modal-btn__text">已送达</text>
            <text class="intercept-modal-btn__desc">拒绝申请（请拒签）</text>
          </button>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 验货不通过弹窗 -->
  <view class="intercept-modal-mask" wx:if="{{showInspectFailModal}}" bindtap="hideInspectFailModal">
    <view class="intercept-modal inspect-fail-modal" catchtap="preventModalClose">
      <view class="intercept-modal__header">
        <text class="intercept-modal__title">验货不通过</text>
        <text class="intercept-modal__close" bindtap="hideInspectFailModal">✕</text>
      </view>
      <view class="intercept-modal__body">
        <text class="intercept-modal__desc">请填写拒绝原因并上传凭证（支持图片和视频）</text>
        
        <view class="inspect-fail__input-section">
          <textarea 
            class="inspect-fail__textarea" 
            placeholder="请输入验货不通过的原因（如空包、商品不符、商品损坏等）"
            value="{{inspectFailReason}}"
            bindinput="onInspectFailReasonInput"
            maxlength="200"
          />
        </view>
        
        <view class="inspect-fail__upload-section">
          <view class="inspect-fail__upload-title">图片凭证（最多9张）</view>
          <view class="inspect-fail__upload-list">
            <view 
              wx:for="{{inspectImages}}" 
              wx:key="index" 
              class="inspect-fail__upload-item"
            >
              <image src="{{item}}" mode="aspectFill" class="inspect-fail__upload-image" bindtap="previewInspectImage" data-index="{{index}}" />
              <text class="inspect-fail__upload-delete" bindtap="deleteInspectImage" data-index="{{index}}">✕</text>
            </view>
            <view 
              wx:if="{{inspectImages.length < 9}}" 
              class="inspect-fail__upload-item inspect-fail__upload-add"
              bindtap="chooseInspectImages"
            >
              <text class="inspect-fail__upload-add-icon">+</text>
            </view>
          </view>
        </view>
        
        <view class="inspect-fail__upload-section">
          <view class="inspect-fail__upload-title">视频凭证（最多1个）</view>
          <view class="inspect-fail__upload-list">
            <view wx:if="{{inspectVideos.length > 0}}" class="inspect-fail__upload-item inspect-fail__upload-video">
              <view class="inspect-fail__video-cover" bindtap="previewInspectVideo">
                <image
                  wx:if="{{inspectVideoThumbs[0]}}"
                  src="{{inspectVideoThumbs[0]}}"
                  class="inspect-fail__upload-video-item"
                  mode="aspectFill"
                />
                <video
                  wx:else
                  src="{{inspectVideos[0]}}"
                  class="inspect-fail__upload-video-item"
                  object-fit="cover"
                  muted
                  controls="{{false}}"
                  show-center-play-btn="{{false}}"
                  show-play-btn="{{false}}"
                  show-fullscreen-btn="{{false}}"
                />
                <view class="inspect-fail__play-btn">
                  <text class="inspect-fail__play-icon">▶</text>
                </view>
              </view>
              <text class="inspect-fail__upload-delete" catchtap="deleteInspectVideo" data-index="0">✕</text>
            </view>
            <view
              wx:if="{{inspectVideos.length < 1}}"
              class="inspect-fail__upload-item inspect-fail__upload-add"
              bindtap="chooseInspectVideo"
            >
              <text class="inspect-fail__upload-add-icon">📹</text>
            </view>
          </view>
        </view>
        
        <button class="inspect-fail__submit-btn" bindtap="submitInspectFail">提交</button>
      </view>
    </view>
  </view>
  
  <!-- 物流信息弹窗 -->
  <view wx:if="{{showLogistics}}" class="logistics-modal">
    <view class="logistics-modal__mask" bindtap="closeLogistics" catchtouchmove="preventTouchMove"></view>
    <scroll-view class="logistics-modal__content" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="logistics-modal__header">
        <text class="logistics-modal__title">{{logisticsModalTitle || '退货物流信息'}}</text>
      </view>
      
      <view class="logistics-modal__info">
        <view class="logistics-modal__info-item">
          <text class="logistics-modal__info-label">快递公司：</text>
          <text class="logistics-modal__info-value">{{logisticsMapData.companyName || logisticsData.com}}</text>
        </view>
        <view class="logistics-modal__info-item">
          <text class="logistics-modal__info-label">运单号：</text>
          <text class="logistics-modal__info-value">{{logisticsData.nu || logisticsMapData.trackingNumber}}</text>
        </view>
        <view class="logistics-modal__info-item">
          <text class="logistics-modal__info-label">物流状态：</text>
          <text class="logistics-modal__info-value" style="color: {{logisticsData.state === '3' ? '#52c41a' : logisticsData.state === '2' ? '#1890ff' : logisticsData.state === '1' ? '#faad14' : logisticsData.state === '4' ? '#ff4d4f' : '#999'}}">
            {{logisticsData.displayStateText || logisticsData.stateName || (logisticsData.state === '0' ? '无轨迹' : logisticsData.state === '1' ? '已揽收' : logisticsData.state === '2' ? '在途中' : logisticsData.state === '3' ? '已签收' : logisticsData.state === '4' ? '问题件' : '待发货')}}
          </text>
        </view>
      </view>
      
      <view class="logistics-modal__track">
        <view class="logistics-modal__track-title">物流轨迹</view>
        <view class="logistics-modal__track-list">
          <view wx:for="{{logisticsData.data}}" wx:key="{{index}}" class="logistics-modal__track-item">
            <view class="logistics-modal__track-dot" style="background-color: {{index === 0 ? '#1890ff' : '#d9d9d9'}}"></view>
            <view class="logistics-modal__track-line" wx:if="{{index < logisticsData.data.length - 1}}" style="background-color: {{index === 0 ? '#1890ff' : '#d9d9d9'}}"></view>
            <view class="logistics-modal__track-content">
              <text class="logistics-modal__track-text">{{item.context}}</text>
              <text class="logistics-modal__track-time">{{item.time}}</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
