.banner-manage {
  min-height: 100vh;
  background-color: var(--color-bg);
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: var(--color-bg-elevated);
  border-bottom: 1rpx solid #eee;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.add-btn {
  padding: 10rpx 20rpx;
  background-color: var(--color-danger);
  color: var(--color-text-inverse);
  border-radius: 8rpx;
  font-size: 28rpx;
  border: none;
}

.banner-list {
  padding: 20rpx;
}

/* 空状态已统一为全局 .empty-view */

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.banner-item {
  background-color: var(--color-bg-elevated);
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.banner-image-wrapper {
  width: 100%;
  position: relative;
  background-color: var(--color-bg);
}

.banner-image {
  width: 100%;
  height: auto;
  min-height: 200rpx;
  display: block;
}

.banner-info {
  padding: 20rpx;
}

.banner-link {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.banner-status {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.sort-order {
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.status-switch {
  transform: scale(0.8);
}

.banner-actions {
  display: flex;
  border-top: 1rpx solid #eee;
}

.action-btn {
  flex: 1;
  padding: 20rpx;
  background-color: transparent;
  border: none;
  font-size: 28rpx;
}

.edit-btn {
  color: var(--color-danger);
  border-right: 1rpx solid #eee;
}

.delete-btn {
  color: var(--color-text-muted);
}