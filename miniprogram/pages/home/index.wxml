<!--pages/home/index.wxml-->

<!-- 轮播图 -->
<view class="swiper-container">
  <!-- 轮播图骨架屏 -->
  <view wx:if="{{bannerLoading}}" class="skeleton-banner-wrapper">
    <view class="skeleton-banner"></view>
  </view>
  
  <!-- 真实轮播图：仅在有数据时渲染，空 swiper 在部分基础库会触发渲染层 $$ 异常 -->
  <swiper
    wx:elif="{{bannerList.length > 0}}"
    indicator-dots="{{true}}"
    autoplay="{{true}}"
    interval="5000"
    duration="1000"
    circular="{{true}}"
    indicator-color="rgba(255, 255, 255, 0.5)"
    indicator-active-color="#ffffff"
  >
    <swiper-item wx:for="{{bannerList}}" wx:key="_id">
      <image
        class="swiper-image"
        src="{{item.image}}"
        mode="aspectFill"
        lazy-load="true"
      />
    </swiper-item>
  </swiper>

  <!-- 无轮播数据时的占位，保持区域高度但不渲染 swiper -->
  <view wx:else class="banner-placeholder"></view>
</view>

<!-- 新品推荐 -->
<view class="new-products-section" wx:if="{{newCarouselList.length >= 3}}">
  <view class="new-products-header">
    <text class="new-products-title">新品推荐</text>
  </view>
  <view class="new-products-container">
    <block wx:for="{{newCarouselList}}" wx:key="_id" wx:for-index="index">
      <view
        class="new-product-item {{index === 0 ? 'new-product-item--left' : index === 1 ? 'new-product-item--center' : 'new-product-item--right'}}"
        bindtap="goToProductDetail"
        data-id="{{item._id}}"
      >
        <image
          class="new-product-image"
          src="{{item.coverImage}}"
          mode="aspectFill"
          lazy-load="true"
        />
        <!-- 遮罩层 -->
        <view wx:if="{{item.isOffline}}" class="new-product-mask new-product-mask--offline">
          <text class="new-product-mask-text">已下架</text>
        </view>
        <view wx:elif="{{item.isOutOfStock}}" class="new-product-mask new-product-mask--outofstock">
          <text class="new-product-mask-text">补货中</text>
        </view>
      </view>
    </block>
  </view>
</view>

<!-- 骨架屏 -->
<view wx:if="{{loading}}" class="skeleton-container">
  <!-- 轮播图骨架 -->
  <view class="skeleton-banner"></view>
  
  <!-- 系列骨架（与真实渲染对齐：3 个系列 × 每个 3 个商品） -->
  <view wx:for="{{[1, 2, 3]}}" wx:key="*this" class="skeleton-series">
    <view class="skeleton-series-header">
      <view class="skeleton-series-title"></view>
      <view class="skeleton-series-subtitle"></view>
    </view>
    <view class="skeleton-series-image"></view>
    <view class="skeleton-products">
      <view wx:for="{{[1, 2, 3]}}" wx:key="*this" class="skeleton-product">
        <view class="skeleton-product-image"></view>
        <view class="skeleton-product-name"></view>
        <view class="skeleton-product-price"></view>
      </view>
    </view>
  </view>
</view>

<view wx:if="{{error}}">
  <!-- 错误状态 -->
  <view class="error-view error-view--page">
    <text class="error-view__text">{{errorMessage}}</text>
    <button class="error-view__btn" bindtap="reloadData">重试</button>
  </view>
</view>

<view wx:elif="{{seriesList.length === 0}}">
  <!-- 空状态 -->
  <view class="empty-view empty-view--page">
    <text class="empty-view__text">暂无系列数据</text>
    <text class="empty-view__subtext">请稍后再来看看吧</text>
    <button class="empty-view__btn" bindtap="reloadData">刷新</button>
  </view>
</view>

<view wx:else>
  <!-- 系列展示 -->
  <block wx:for="{{seriesList}}" wx:key="id">
    <view class="series-section">
      <view class="series-header">
        <text class="series-title">{{item.title}}</text>
        <text class="series-subtitle">{{item.subtitle}}</text>
      </view>
      
      <view class="series-main-image">
        <image src="{{item.mainImage}}" mode="widthFix" />
        <view class="series-explore">
          <text class="series-explore-text">探索全部</text>
          <view class="series-explore-bar"></view>
        </view>
      </view>
      
      <view class="series-products">
        <block wx:for="{{item.products}}" wx:key="_id" wx:for-item="product">
          <view class="series-product-item" bindtap="goToProductDetail" data-id="{{product._id}}">
            <image class="series-product-image" src="{{product.coverImage}}" mode="aspectFill" />
            <text class="series-product-name">{{product.name}}</text>
            <text class="series-product-price">￥{{product.price || 0}}</text>
            <view wx:if="{{product.isOffline}}" class="product-mask product-mask--offline">
              <text class="product-mask-text">已下架</text>
            </view>
            <view wx:elif="{{product.isOutOfStock}}" class="product-mask product-mask--outofstock">
              <text class="product-mask-text">补货中</text>
            </view>
          </view>
        </block>
      </view>
    </view>
  </block>
</view>