/* components/modal-shell/index.wxss
   通用弹层基座：统一遮罩、面板圆角、标题栏与出现动画 */
.modal-shell {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10010;
  display: flex;
  justify-content: center;
}

.modal-shell--bottom {
  align-items: flex-end;
}

.modal-shell--center {
  align-items: center;
}

.modal-shell__mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  animation: modal-shell-fade-in 0.2s ease-out;
}

.modal-shell__panel {
  position: relative;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background-color: #fff;
}

.modal-shell--bottom .modal-shell__panel {
  width: 100%;
  max-height: 85vh;
  border-radius: 24rpx 24rpx 0 0;
  /* 底部弹层统一避让 iPhone home indicator */
  padding-bottom: env(safe-area-inset-bottom);
  animation: modal-shell-slide-up 0.25s ease-out;
}

.modal-shell--center .modal-shell__panel {
  width: 600rpx;
  max-height: 70vh;
  border-radius: 20rpx;
  animation: modal-shell-zoom-in 0.2s ease-out;
}

.modal-shell__header {
  position: relative;
  display: flex;
  align-items: center;
  flex-shrink: 0;
  min-height: 96rpx;
  padding: 0 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-shell__header--left {
  justify-content: space-between;
}

.modal-shell__header--center {
  justify-content: center;
}

.modal-shell__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.modal-shell__close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  line-height: 1;
  color: #999;
}

/* 居中标题时关闭按钮绝对定位，避免标题被挤偏 */
.modal-shell__header--center .modal-shell__close {
  position: absolute;
  right: 20rpx;
}

.modal-shell__body {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

@keyframes modal-shell-fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes modal-shell-slide-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes modal-shell-zoom-in {
  from { opacity: 0; transform: scale(0.92); }
  to { opacity: 1; transform: scale(1); }
}
