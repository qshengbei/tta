/* 物流信息弹层（原订单列表/订单详情/售后详情页内实现统一搬移至此，取并集）
   外壳（遮罩/面板圆角/标题栏/动画/滚动穿透）由 modal-shell 提供 */
.logistics-modal__content {
  flex: 1;
  min-height: 0;
}

.logistics-modal__info {
  padding: 24rpx;
  background-color: #fafafa;
}

.logistics-modal__info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.logistics-modal__info-label {
  font-size: 26rpx;
  color: #999;
}

.logistics-modal__info-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.logistics-modal__track {
  padding: 24rpx;
  flex: 1;
  overflow-y: auto;
}

.logistics-modal__track-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.logistics-modal__track-list {
  padding-left: 20rpx;
}

.logistics-modal__track-item {
  display: flex;
  padding: 16rpx 0;
  position: relative;
}

.logistics-modal__track-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #d9d9d9;
  margin-right: 20rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.logistics-modal__track-line {
  position: absolute;
  left: 7rpx;
  top: 36rpx;
  bottom: 0;
  width: 2rpx;
  background-color: #d9d9d9;
}

.logistics-modal__track-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.logistics-modal__track-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
}

.logistics-modal__track-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.logistics-modal__map-section {
  margin-bottom: 24rpx;
}

.logistics-modal__map-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
  border-left: 4rpx solid #1890ff;
}

.logistics-modal__map-container {
  width: 100%;
  height: 400rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.logistics-modal__map {
  width: 100%;
  height: 100%;
}

.logistics-modal__map-buttons {
  display: flex;
  justify-content: flex-end;
}

.logistics-modal__map-btn {
  margin: 0 8rpx;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  border-radius: 8rpx;
  border: 1rpx solid #d9d9d9;
  background: #fff;
  color: #333;
}

.logistics-modal__map-btn::after {
  border: none;
}
