/* 快递计算规则弹层（原商品详情/确认订单页内实现统一搬移至此）
   外壳（遮罩/面板圆角/标题栏/动画/滚动穿透）由 modal-shell 提供 */
.express-rules-modal__content {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding: 32rpx;
}

.express-rules-modal__scroll {
  flex: 1;
  overflow-y: auto;
  padding: 0 8rpx;
  -webkit-overflow-scrolling: touch;
}

.express-rules-modal__rules {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.express-rule-item {
  padding: 24rpx;
  background-color: #f8f8f8;
  border-radius: 16rpx;
}

.express-rule-item__region {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.express-rule-item__provinces {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.express-rule-item__province {
  font-size: 24rpx;
  color: #666;
  background-color: #e8e8e8;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
}

.express-rule-item__fee-free {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex-wrap: wrap;
}

.express-rule-item__fee,
.express-rule-item__free {
  display: flex;
  align-items: center;
}

.express-rule-item__fee-label,
.express-rule-item__free-label {
  font-size: 24rpx;
  color: #666;
  margin-right: 8rpx;
}

.express-rule-item__fee-value,
.express-rule-item__free-value {
  font-size: 24rpx;
  color: #333;
  font-weight: 500;
}

.express-rule-item__fee-value {
  color: #0066cc; /* 克莱因蓝 */
}

.express-rules-modal__tip {
  font-size: 22rpx;
  color: #999;
  text-align: left;
  padding: 24rpx;
  margin-top: 16rpx;
  background-color: #f8f8f8;
  border-radius: 16rpx;
  line-height: 1.4;
}

.express-rules-modal__cancel {
  height: 88rpx;
  background-color: #f5f5f5;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  cursor: pointer;
  margin-top: 32rpx;
}
